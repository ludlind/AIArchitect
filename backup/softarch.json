{
  "llmactor-presets": {
    "RequirementAnalyzer": {
      "input_variables": ["description", "memory"],
      "template": "{memory} Analyze the following software description and extract the requirements: \"{description}\"."
    },
    "Architect": {
      "input_variables": ["requirements", "memory"],
      "template": "{memory} Design a software architecture based on the following requirements: \"{requirements}\"."
    },
    "Developer": {
      "input_variables": ["architecture", "memory"],
      "template": "{memory} Develop a piece of software based on the following architecture: \"{architecture}\"."
    },
    "TestDesigner": {
      "input_variables": ["requirements", "memory"],
      "template": "{memory} Design test cases based on the following requirements: \"{requirements}\"."
    },
    "Tester": {
      "input_variables": ["software", "test_cases", "memory"],
      "template": "{memory} Test the following software: \"{software}\" using the test cases: \"{test_cases}\"."
    },
    "Summarizer": {
      "input_variables": ["memory"],
      "template": "Summarize the following: \"{memory}\""
    }
  },
  "architecture": {
    "setup_stage": {
      "i": {"inputactor": "", "name": "", "receive": {"prompt": "Please provide a description of the software you want to develop: "}},
      "ra": {"llmactor": ["RequirementAnalyzer"], "name": ""},
      "ar": {"llmactor": ["Architect"], "name": ""},
      "dev": {"llmactor": ["Developer"], "name": ""},
      "td": {"llmactor": ["TestDesigner"], "name": ""},
      "t": {"llmactor": ["Tester"], "name": ""},
      "s": {"llmactor": ["Summarizer"], "name": ""},
      "m": {"memoryactor": ""}
    },
    "structure_stage": {
      "i": {
        "bind": {"ra": "description", "m": "store"},
        "alert": {"m": "", "ra": ""}
      },
      "ra": {
        "bind": {"ar": "requirements", "td": "requirements", "m": "store"},
        "alert": {"m": "", "ar": ""}
      },
      "ar": {
        "bind": {"dev": "architecture", "m": "store"},
        "alert": {"m": "", "dev": ""}
      },
      "dev": {
        "bind": {"t": "software", "m": "store"},
        "alert": {"m": "", "td": ""}
      },
      "td": {
        "bind": {"t": "test_cases", "m": "store"},
        "alert": {"m": "", "t": ""}
      },
      "t": {
        "bind": {"m": "store"},
        "alert": {"m": ""}
      },
      "m": {
        "bind": {"ra": "memory", "ar": "memory", "dev": "memory", "t": "memory", "td": "memory"}
      }
    },
    "run": {
	"i": {"act": ""}
    }
  }
}

