{
    "architecture": {
        "setup stage": {
            "Input 1": {
                "inputactor": ""
            },
            "OrderedLister 1": {
                "llmactor": "OrderedLister"
            },
            "Checker 1": {
                "llmactor": "Checker",
                "receive": {
                    "condition": "The text is a list"
                }
            },
            "Conditional 1": {
                "conditionalactor": ""
            },
            "Voice 1": {
                "voiceactor": "",
                "receive": {
                    "text": "Not a list",
                    "voice": "Bella"
                }
            },
            "Voice 2": {
                "voiceactor": "",
                "receive": {
                    "text": "The text is a list",
                    "voice": "Bella"
                }
            }
        },
        "structure stage": {
            "Input 1": {
                "alert": {
                    "OrderedLister 1": ""
                },
                "bind": {
                    "OrderedLister 1": "subject"
                }
            },
            "OrderedLister 1": {
                "alert": {
                    "Checker 1": ""
                },
                "bind": {
                    "Checker 1": "text"
                }
            },
            "Checker 1": {
                "alert": {
                    "Conditional 1": ""
                },
                "bind": {
                    "Conditional 1": "text"
                }
            },
            "Conditional 1": {
                "bind": {
                    "Voice 2": ["wake", "if-true"],
                    "Voice 1": ["wake", "if-false"]
                }
            }
        },
        "run stage": {
            "Input 1": {
                "act": ""
            }
        }
    },
    "include": [
        "presets/preset.json"
    ]
}
